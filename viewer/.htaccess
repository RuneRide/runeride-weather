# SPDX-License-Identifier: EUPL-1.2
# Viewer RuneRide Météo (« Les Augures ») sur o2switch (Apache) : fichiers statiques uniquement.
# Racine web dédiée de weather.runeride.fr ; les données sont servies par weather-data.runeride.fr (CloudFront).
DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8
AddType text/javascript .js
AddType application/manifest+json .webmanifest
AddType application/x-protobuf .pbf
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
RewriteEngine On
# HTTPS partout
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://weather.runeride.fr%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
Header always set Strict-Transport-Security "max-age=31536000"
# CSP : tout vient du site lui-même (MapLibre, pmtiles, polices et sprites sont copiés dans vendor/ et assets/).
#  - connect-src : le site et l'hôte des données (manifeste, tuiles PMTiles par Range, isobares, fond de carte) ;
#  - worker-src blob: : MapLibre GL JS crée ses workers à partir d'un Blob ;
#  - img-src data: blob: : sprites décodés et tuiles de données (createImageBitmap) ;
#  - pas de 'unsafe-eval' ni de script en ligne ; WebGL n'est pas concerné par la CSP.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://weather-data.runeride.fr; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"

# Page, code, manifeste web et service worker : toujours revalidés (ETag), pour qu'un déploiement s'applique tout de suite
<FilesMatch "\.(html|js|css|webmanifest)$">
Header set Cache-Control "no-cache"
</FilesMatch>
# Bibliothèques, polices, sprites, icônes : peu de changements (un changement = nouvelle version de cache dans sw.js)
<FilesMatch "\.(pbf|png|svg|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<Files "sw.js">
Header set Cache-Control "no-cache"
Header set Service-Worker-Allowed "/"
</Files>
<FilesMatch "^maplibre-gl\.(js|css)$|^pmtiles\.js$|^basemaps\.js$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json application/x-protobuf image/svg+xml
</IfModule>

# Fichier d'état de la synchro FTP (déploiement) et fichiers de travail : jamais servis
# (tests/, tools/, serve.py ne sont de toute façon pas envoyés : voir .github/workflows/deploy.yml)
<FilesMatch "^(\.ftp-deploy-sync-state\.json|.*\.(py|mjs))$|^\.git">
Require all denied
</FilesMatch>
